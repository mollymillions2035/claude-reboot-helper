[Unit]
Description=Quit Claude Desktop cleanly before logout
Documentation=file://%h/.local/bin/claude-desktop-quit-on-shutdown
# Stopped before graphical-session.target, so before Hyprland goes down.
# Stopping this unit by hand quits Claude Desktop.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=%h/.local/bin/claude-desktop-quit-on-shutdown --now
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
